digraph calls {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.35", nodesep="0.24", ranksep="0.65", splines=polyline, fontname="WenQuanYi Zen Hei", fontsize=22, fontcolor="#132d46", label="03  关键函数调用\n实线：直接调用；框内列出同一模块的相关函数；省略文件 I/O 与通用校验辅助函数", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#91abc6", fontname="WenQuanYi Zen Hei", fontsize=14, fontcolor="#132d46", margin="0.18,0.13", penwidth=1.2];
  edge [color="#57738d", arrowsize=0.65, fontname="WenQuanYi Zen Hei", fontsize=11, fontcolor="#456078"];
  main [label="scripts/run_chain_workbench.py\nmain()", fillcolor="#173d54", color="#173d54", fontcolor=white];
  run [label="run_case()\n调度：案例 → 候选范围 → POI 策略", fillcolor="#173d54", color="#173d54", fontcolor=white];
  main -> run;
  load [label="run_chain_workbench.py\nload_ledger() · budgets_for()\n读候选账本，构造预算"];
  expand [label="chain_workbench_inputs.py\nexpand_candidate_window()\n可选的活动边界扩展"];
  history [label="chain_workbench_history.py\ncomplete_missing_rarity()（扩展时）\nprepare_history()\n补齐分数并取严格在先的上下文历史"];
  evidence [label="chain_workbench.py\nprepare_evidence()\n准备各评分版本的证据", fillcolor="#eaf7f2", color="#7bbba7"];
  variant [label="chain_workbench.py\nrun_variant()\n起点 → 评分 → 见证 → 各预算选择", fillcolor="#eaf7f2", color="#7bbba7"];
  frozen [label="chain_workbench.py\nfreeze_variant() · validate_variant()\n冻结并检查精确决策", fillcolor="#eeeafa", color="#b1a2d1"];
  run -> load [label="准备输入 / 预算"];
  run -> expand [label="可选"];
  run -> history;
  run -> evidence [label="每个候选范围"];
  run -> variant [label="每种 POI 策略"];
  run -> frozen [label="策略完成后"];
  model [label="contextual_rarity.py\nContextualRarityModel.fit()\nContextualRarityModel.score_rows()\n条件惊异度与历史支持度", fillcolor="#eaf7f2", color="#7bbba7"];
  reliable [label="adaptive_pois.py\nreliability_rarity()\n频率与上下文的置信度融合", fillcolor="#eaf7f2", color="#7bbba7"];
  evidence -> model;
  evidence -> reliable;
  propagate [label="rasp.py\npropagate()\n背景对照、多 POI 事件评分", fillcolor="#eaf7f2", color="#7bbba7"];
  adaptive [label="adaptive_pois.py\nselect_adaptive_pois()\n仅 adaptive 策略调用"];
  routes [label="rasp.py\ntemporal_routes()\ntemporal_fork_routes()\n有向时序路由与共同祖先分叉"];
  build [label="adaptive_chains.py\nbuild_chain_bundles()\n候选内前后文与分支见证包"];
  choose [label="adaptive_chains.py\nselect_adaptive_bundles()\n当前主方法：整包优先 + 时序回退"];
  baseline [label="rasp.py\nselect_fork_bundles()\n其他五种对照方法的预算选择", fillcolor="#f5f7fa", color="#c5d0dc"];
  variant -> adaptive [label="预评分后"];
  variant -> propagate [label="预评分 / 正式评分"];
  variant -> routes [label="资格集合"];
  variant -> build [label="两个整链版本"];
  variant -> choose [label="每个预算"];
  variant -> baseline [label="对照组"];
  channel [label="rasp.py\ninteraction_graph()\n按端点对 / 关系合并重复交互通道", fillcolor="#eaf7f2", color="#7bbba7"];
  ppr [label="rasp.py\npersonalized_pagerank()\n背景一次 + 每个 POI 一次\nrestart = 0.15", fillcolor="#eaf7f2", color="#7bbba7"];
  shared [label="rasp.py（重复列出以便阅读）\ntemporal_routes()\ntemporal_fork_routes()\n构建与选择阶段复用同一时序约束"];
  walks [label="adaptive_chains.py\n_continuations() · _walk()\n寻找连续事件并扩展前后路径"];
  propagate -> channel;
  propagate -> ppr;
  build -> shared;
  choose -> shared;
  build -> walks;
  read [label="chain_workbench_inputs.py\nread_interval()\n只读 SQLite 时间区间"];
  expand -> read;
}
